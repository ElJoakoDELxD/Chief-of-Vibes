#!/usr/bin/env bash
#
# Prints the current time as "DD-MM-YYYY HH:MM ±TZ". Pipe it into `header`.
#
# The format is the constant. How the time is obtained is not: it depends on the
# environment, so this script keeps no fixed method. It tests candidate methods,
# and it saves the first one that passes as evidence in tools/clock/methods.tsv,
# keyed by an environment signature. The next session in the same environment
# runs the saved method first, and tests it again before it trusts it.
#
# A test compares the method's reading with an independent reference: the Date
# header of an HTTPS server. More than 3 minutes apart is DESFASE. DESFASE goes to
# stderr and changes nothing: the agent asks the Principal whether the time was
# right before it fixes anything, because the likelier error is in the check.
#
# Zone, in order: $TS_ZONE, the timezone field of memory/state.md, $COV_TZ, UTC.
# UTC with no zone declared is the expected state of the canon, not an error.
# $TS_CTX_DATE (YYYY-MM-DD, the date the agent's context claims) is optional; a
# mismatch with the clock's own date is also DESFASE.
#
# Test seams: COV_CLOCK_RECORD (the record file), COV_CLOCK_REFERENCE_EPOCH (a
# fixed reference instead of the network), COV_CLOCK_SIGNATURE.

set -uo pipefail

root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
record="${COV_CLOCK_RECORD:-${root}/tools/clock/methods.tsv}"
threshold=180

zone="${TS_ZONE:-}"
if [[ -z "${zone}" && -f "${root}/memory/state.md" ]]; then
  zone="$(awk '/^---[[:space:]]*$/{f++;next} f==1 && $1=="timezone:"{sub(/^[^:]*:[[:space:]]*/,"");sub(/[[:space:]]*#.*$/,"");gsub(/["'\''`[:space:]]/,"");print;exit}' "${root}/memory/state.md")"
fi
[[ -z "${zone}" ]] && zone="${COV_TZ:-}"
[[ -z "${zone}" ]] && zone="UTC"

signature="${COV_CLOCK_SIGNATURE:-$(uname -s 2>/dev/null | cut -d- -f1)/${CLAUDE_CODE_REMOTE_ENVIRONMENT_TYPE:-local}}"

# Each method prints "EPOCH|DD-MM-YYYY HH:MM +HHMM" for the zone, or fails.
method_date_tzdata() {
  [[ "${zone}" == "UTC" || ( "${zone}" != *..* && -e "${TZDIR:-/usr/share/zoneinfo}/${zone}" ) ]] || return 1
  TZ="${zone}" date '+%s|%d-%m-%Y %H:%M %z' 2>/dev/null
}
method_python_zoneinfo() {
  command -v python3 >/dev/null 2>&1 || return 1
  python3 - "${zone}" <<'PY' 2>/dev/null
import sys, time
from datetime import datetime
from zoneinfo import ZoneInfo
now = datetime.now(ZoneInfo(sys.argv[1]))
print(f"{int(now.timestamp())}|{now.strftime('%d-%m-%Y %H:%M %z')}")
PY
}
candidates=(date_tzdata python_zoneinfo)

reference_epoch() {
  if [[ -n "${COV_CLOCK_REFERENCE_EPOCH:-}" ]]; then printf '%s' "${COV_CLOCK_REFERENCE_EPOCH}"; return 0; fi
  local d
  d="$(curl -sSI --max-time 4 https://api.anthropic.com 2>/dev/null | awk -F': ' 'tolower($1)=="date"{print $2}' | tr -d '\r')"
  [[ -n "${d}" ]] || return 1
  date -u -d "${d}" +%s 2>/dev/null
}

run_method() { local out; out="$("method_$1")" || return 1; [[ "${out}" =~ ^[0-9]+\|[0-9]{2}-[0-9]{2}-[0-9]{4}\ [0-9]{2}:[0-9]{2}\ [+-][0-9]{4}$ ]] || return 1; printf '%s' "${out}"; }

ref="$(reference_epoch)" || ref=""
saved="$(awk -F'\t' -v s="${signature}" '$1==s{m=$2} END{print m}' "${record}" 2>/dev/null)"

reading=""; used=""
if [[ -n "${saved}" ]] && declare -F "method_${saved}" >/dev/null; then
  reading="$(run_method "${saved}")" && used="${saved}"
  [[ -z "${used}" ]] && echo "clock: the saved method '${saved}' failed here; testing the others." >&2
fi
if [[ -z "${used}" ]]; then
  for m in "${candidates[@]}"; do
    [[ "${m}" == "${saved}" ]] && continue
    reading="$(run_method "${m}")" || continue
    epoch="${reading%%|*}"
    if [[ -n "${ref}" ]] && (( ${epoch} - ref > threshold || ref - ${epoch} > threshold )); then
      echo "clock: method '${m}' read ${epoch}, reference ${ref}; not saved." >&2
      continue
    fi
    used="${m}"
    if [[ -n "${ref}" ]]; then evidence="read ${reading#*|}; reference $(date -u -d "@${ref}" '+%d-%m-%Y %H:%M:%S UTC'); delta $(( epoch - ref ))s"
    else evidence="read ${reading#*|}; reference unreachable, not cross-checked"; fi
    mkdir -p "$(dirname "${record}")"
    printf '%s\t%s\t%s\t%s\n' "${signature}" "${m}" "$(date -u +%Y-%m-%d)" "${evidence}" >> "${record}"
    echo "clock: new environment '${signature}'; method '${m}' tested and saved to ${record#${root}/}. Commit it." >&2
    break
  done
fi

if [[ -z "${used}" ]]; then
  echo "clock: no method produced a time for zone '${zone}' in '${signature}'. No time printed; do not invent one." >&2
  exit 1
fi

epoch="${reading%%|*}"
stamp="$(printf '%s' "${reading#*|}" | sed -E 's/([+-][0-9]{2})([0-9]{2})$/\1:\2/; s/:00$//')"

if [[ -z "${ref}" ]]; then
  echo "clock: reference unreachable; the reading was not cross-checked." >&2
elif (( epoch - ref > threshold || ref - epoch > threshold )); then
  echo "DESFASE: the clock reads $(( epoch - ref ))s away from the reference. Ask the Principal whether the time is right before fixing anything." >&2
fi
if [[ -n "${TS_CTX_DATE:-}" ]]; then
  own="$(TZ="${zone}" date -d "@${epoch}" +%Y-%m-%d 2>/dev/null || true)"
  [[ -n "${own}" && "${own}" != "${TS_CTX_DATE}" ]] && echo "DESFASE: the context date is ${TS_CTX_DATE} and the clock's is ${own}. Ask the Principal before fixing anything." >&2
fi

printf '%s\n' "${stamp}"
